# Copy this file to .env (which Git ignores) and fill in your own token.
# Never commit .env or paste its contents into chat.
ONEMAP_TOKEN=
ANTHROPIC_API_KEY=
# Optional: OIKOS_LLM_MODEL=openrouter:deepseek/deepseek-v4.1-flash-1017 (the default), or a Claude model id such as claude-haiku-5-5

OPENROUTER_API_KEY=

# Optional: override the daily AI answers for visitors (default 3) and free accounts (default 10). Plans are in src/accounts.py.
# OIKOS_LIMIT_ANON=3
# OIKOS_LIMIT_USER=10

# URA Data Service access key, for condo and landed prices (see docs/PRIVATE_PROPERTY_PLAN.md)
URA_ACCESS_KEY=

# Optional: your OneMap account, so commute times keep working (a ONEMAP_TOKEN alone expires after three days)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Limits (all optional). Visitors without an account also share an allowance per network address, so clearing
# cookies does not reset it; the default is 5 times OIKOS_LIMIT_ANON.
# OIKOS_LIMIT_ANON_IP=15
# The most the AI may cost in a day, in US cents. Past it, answers are rule-based until midnight Singapore time.
# OIKOS_DAILY_BUDGET_CENTS=300
# Set to 1 when the app runs behind a reverse proxy, so the visitor's address is read from X-Forwarded-For.
# OIKOS_TRUST_PROXY=1
